# Hostinger (Apache) instellingen voor de statische site

# De statische site gaat voor (ook als er nog een oude index.php staat)
DirectoryIndex index.html

# Altijd https
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# De oude testomgeving (nieuw.alieke.design en alieke.design/nieuw/) is niet meer in
# gebruik: stuur alles daar naar dezelfde pagina op alieke.design.
RewriteCond %{HTTP_HOST} ^nieuw\.alieke\.design$ [NC]
RewriteRule ^(.*)$ https://alieke.design/$1 [L,R=301]
RewriteCond %{REQUEST_URI} ^/nieuw(/(.*))?$
RewriteRule ^ https://alieke.design/%2 [L,R=301]

# De dienstpagina heette eerst ai-design-consultancy
RewriteRule ^ai-design-consultancy/?$ /ai-design-consultant/ [L,R=301]

# www naar zonder www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Oude WordPress-adressen naar de homepage
RewriteRule ^(wp-admin|wp-login\.php|feed|xmlrpc\.php)(/.*)?$ / [L,R=301]
RewriteRule ^(page-)?sitemap(_index)?\.xml$ /sitemap.xml [L,R=301]
# Oude WordPress-links met ?p=, ?page_id= of ?attachment_id= naar de homepage (zonder query)
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|attachment_id)=\d+ [NC]
RewriteRule ^$ /? [L,R=301]
RewriteRule ^wp-sitemap\.xml$ /sitemap.xml [L,R=301]

ErrorDocument 404 /404.html

# De servercache van Hostinger (LiteSpeed) mag html-pagina's niet vasthouden,
# anders zie je na een deploy nog minutenlang de oude pagina. Plaatjes, css en js
# hebben een hash in de naam en mogen wel gecachet worden.
RewriteCond %{REQUEST_URI} !\.(css|js|webp|png|jpg|svg|woff2?|ico|xml|txt)$ [NC]
RewriteRule .* - [E=Cache-Control:no-cache]
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set X-LiteSpeed-Cache-Control "no-cache"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Caching: bestanden met een hash in de naam mogen lang bewaard worden
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
