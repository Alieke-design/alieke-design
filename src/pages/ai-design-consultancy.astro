---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const nav = [
  { href: '#waarom', label: 'Waarom' },
  { href: '#voor-wie', label: 'Voor wie' },
  { href: '#aanpak', label: 'Aanpak' },
  { href: '#wat-je-krijgt', label: 'Wat je krijgt' },
  { href: '#scan', label: 'De scan' },
  { href: '#contact', label: 'Contact' },
];
---
<Base
  title="AI Design Consultancy - Alieke.design"
  description="Eén designbasis voor de hele organisatie, klaar om zelf met AI mee te werken. Met beheer en review door een senior designer."
  ogImage="/og-consultancy.png"
  ogImageAlt="AI Design Consultancy door Alieke Zelhorst"
  nav={nav}
  menuNote="Je krijgt binnen een werkdag reactie."
>
<div class="consultancy">
  <section id="hi" style="max-width: 1120px; margin: 0 auto; padding: clamp(40px, 6vw, 96px) 16px clamp(64px, 8vw, 117px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px 64px;">
    <div style="flex: 1 1 460px; min-width: 0; max-width: 616px;">
      <p data-rv style="display: inline-block; margin: 0; padding: 4px 12px; border-radius: 48px; background: #ffc518; color: #232323; font-size: 16px; font-weight: 600; line-height: 1.4;">Nieuw</p>
      <h1 data-rv style="margin: 12px 0 0; font-size: clamp(40px, 3.125vw, 45px); line-height: 1; font-weight: 600; color: #0d0064;">AI Design Consultant</h1>
      <ul data-rv style="margin: 40px 0 0; padding: 0; list-style: none; display: grid; gap: 12px; font-size: 18px; line-height: 1.4;">
        <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.75 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span><strong style="font-weight: 600;">Eén designbasis</strong> voor de hele organisatie</span></li>
        <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.75 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span><strong style="font-weight: 600;">Klaar om zelf</strong> met AI mee te werken</span></li>
        <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.75 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span><strong style="font-weight: 600">Beheer en review</strong> door een senior designer</span></li>
      </ul>
      <a data-rv href="#aanpak" style="display: inline-flex; align-items: center; gap: 10px; margin-top: 32px; padding: 17.8px 28.3px; border-radius: 14.08px; background: #0049dc; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none; box-shadow: 3.52px -3.52px 0 0 #232323;">Bekijk de aanpak<svg viewBox="0 0 14 15" aria-hidden="true" style="width: 13px; height: 14px; fill: #ffffff;"><path d="M6.28125 13.7188L1.28125 8.71875C0.875 8.34375 0.875 7.6875 1.28125 7.3125C1.65625 6.90625 2.3125 6.90625 2.6875 7.3125L6 10.5938V1C6 0.46875 6.4375 0 7 0C7.53125 0 8 0.46875 8 1V10.5938L11.2812 7.3125C11.6562 6.90625 12.3125 6.90625 12.6875 7.3125C13.0938 7.6875 13.0938 8.34375 12.6875 8.71875L7.6875 13.7188C7.3125 14.125 6.65625 14.125 6.28125 13.7188Z"></path></svg></a>
    </div>

    <div class="ill" data-rv data-scroll-translate data-target="parent" data-translate-y="-0.6" style="flex: 1 1 320px; max-width: 440px; margin: 0 auto;">
      <svg class="hero-ill" viewBox="0 0 440 440" aria-hidden="true" style="display: block; width: 100%; height: auto;">
        <circle cx="236" cy="232" r="176" fill="none" stroke="#0049dc" stroke-width="3"></circle>
        <circle cx="210" cy="220" r="176" fill="#ffc518"></circle>
        <g fill="none" stroke="#0d0064" stroke-width="3" stroke-linejoin="round">
          <rect class="hi-float" style="--fd:.35s" x="22" y="34" width="44" height="44" rx="6" transform="rotate(-14 44 56)"></rect>
          <rect class="hi-float" style="--fd:.5s" x="92" y="6" width="30" height="30" rx="15"></rect>
        </g>
        <rect class="hi-float" style="--fd:.65s" x="44" y="104" width="26" height="26" rx="4" fill="#0049dc" transform="rotate(18 57 117)"></rect>
        <text class="hi-float" style="--fd:.8s" x="132" y="74" font-family="Poppins, sans-serif" font-size="26" font-weight="600" fill="#0d0064" transform="rotate(-10 150 66)">Aa</text>
        <g class="hi-fade" stroke="#0d0064" stroke-width="3" stroke-linecap="round" fill="none" stroke-dasharray="2 9">
          <path d="M82 96 C 104 120 112 132 122 146"></path>
          <path d="M168 84 C 176 104 182 116 188 128"></path>
        </g>
        <rect x="100" y="134" width="252" height="224" rx="8" fill="#ffffff"></rect>
        <text x="124" y="194" font-family="Poppins, sans-serif" font-size="42" font-weight="600" fill="#0d0064">Aa</text>
        <circle class="hi-pop" style="--fd:.55s" cx="250" cy="180" r="15" fill="#0049dc"></circle>
        <circle class="hi-pop" style="--fd:.65s" cx="288" cy="180" r="15" fill="#0d0064"></circle>
        <circle class="hi-pop" style="--fd:.75s" cx="326" cy="180" r="15" fill="#ffc518" stroke="#0d0064" stroke-width="2"></circle>
        <rect x="128" y="218" width="118" height="40" rx="10" fill="#232323"></rect>
        <rect x="124" y="222" width="118" height="40" rx="10" fill="#0049dc"></rect>
        <rect x="144" y="238" width="62" height="8" rx="4" fill="#ffffff"></rect>
        <rect x="124" y="286" width="204" height="10" rx="5" fill="#e3f0ff"></rect>
        <rect x="124" y="308" width="150" height="10" rx="5" fill="#e3f0ff"></rect>
        <g class="hi-pop" style="--fd:1s"><circle cx="352" cy="352" r="34" fill="#0049dc"></circle>
        <path d="M336 352 l11 11 l22 -22" fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path></g>
      </svg>
    </div>
  </section>
  <section id="waarom" style="background: #e3f0ff; position: relative;">
    <div style="max-width: 1120px; margin: 0 auto; padding: clamp(64px, 8vw, 117px) 16px calc(clamp(96px, 10vw, 140px) + 40px); position: relative;">

      <p data-rv style="display: inline-block; margin: 0; padding: 4px 12px; border-radius: 48px; background: #0d0064; color: #ffffff; font-size: 16px; font-weight: 600; line-height: 1.4;">Waarom</p>
      <h2 data-rv style="margin: 12px 0 0; font-size: clamp(40px, 3.125vw, 45px); line-height: 1; font-weight: 600; color: #0049dc;">AI vermenigvuldigt</h2>
      <p data-rv style="margin: 12px 0 0; font-size: clamp(24px, 1.875vw, 27px); line-height: 1.1; font-weight: 400; color: #0d0064;">Dus zorg dat de basis klopt</p>
      <div style="max-width: 630px; margin-top: 40px; font-size: 18px; line-height: 1.6; display: grid; gap: 18px;">
        <p data-rv style="margin: 0;">Met AI-tools maakt iedereen in een paar minuten een pagina, een flow of een hele app. Die tools bouwen voort op wat er al ligt. Is de basis rommelig of verspreid over afdelingen en bestanden, dan wordt dit razendsnel overal herhaald.</p>
        <p data-rv style="margin: 16px 0 0; padding: 0 0 0 24px; border-left: 4px solid #ffc518; max-width: 630px; font-size: clamp(20px, 1.6vw, 23px); line-height: 1.4; font-weight: 600; color: #0d0064;">Met één goede <span class="qk">basis<svg viewBox="0 0 220 70" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M118 5 C 62 1, 9 13, 7 35 C 5 57, 66 67, 118 65 C 172 63, 215 51, 213 33 C 211 13, 162 3, 96 9"></path></svg></span> en een senior designer die meekijkt, maakt <span class="qk">iedereen<svg viewBox="0 0 220 70" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M120 6 C 60 2, 8 14, 6 36 C 4 58, 70 66, 120 64 C 175 62, 216 50, 214 32 C 212 12, 160 4, 100 8"></path></svg></span> werk dat klopt: consistent, toegankelijk en intuïtief.</p>
      </div>
    </div>
  </section>
  <section id="voor-wie" style="position: relative; background-color: var(--surface, #ffffff)">
   <div style="max-width: 1120px; margin: 0 auto; padding: clamp(64px, 8vw, 117px) 16px; display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 48px 56px;">
    <div class="ill" data-rv data-scroll-translate data-target="parent" data-scroll-offset-y="top bottom" data-translate-y="-0.5" style="flex: 1 1 300px; max-width: 360px; margin: 0 auto;">
        <svg viewBox="0 0 440 400" aria-hidden="true" style="display: block; width: 100%; height: auto;">
          <circle cx="200" cy="214" r="154" fill="none" stroke="#ffc518" stroke-width="4"></circle>
          <circle cx="224" cy="200" r="154" fill="#e3f0ff"></circle>
          <g fill="none" stroke="#0d0064" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9">
            <path d="M136 124 L 170 156"></path><path d="M312 124 L 278 156"></path>
            <path d="M136 280 L 170 248"></path><path d="M312 280 L 278 248"></path>
          </g>
          <rect x="164" y="150" width="120" height="104" rx="10" fill="#ffffff"></rect>
          <text x="182" y="198" font-family="Poppins, sans-serif" font-size="30" font-weight="600" fill="#0d0064">Aa</text>
          <rect x="183" y="215" width="72" height="24" rx="7" fill="#232323"></rect>
          <rect x="180" y="218" width="72" height="24" rx="7" fill="#0049dc"></rect>
          <g transform="translate(108 98)"><clipPath id="av1"><circle r="36"></circle></clipPath><circle r="36" fill="#0d0064"></circle><g clip-path="url(#av1)"><circle cx="0" cy="-7" r="12" fill="#ffffff"></circle><ellipse cx="0" cy="32" rx="24" ry="20" fill="#ffffff"></ellipse></g><circle r="36" fill="none"></circle></g>
          <g transform="translate(340 98)"><clipPath id="av2"><circle r="36"></circle></clipPath><circle r="36" fill="#ffc518"></circle><g clip-path="url(#av2)"><circle cx="0" cy="-7" r="12" fill="#0d0064"></circle><ellipse cx="0" cy="32" rx="24" ry="20" fill="#0d0064"></ellipse></g><circle r="36" fill="none"></circle></g>
          <g transform="translate(108 306)"><clipPath id="av3"><circle r="36"></circle></clipPath><circle r="36" fill="#ffffff"></circle><g clip-path="url(#av3)"><circle cx="0" cy="-7" r="12" fill="#0049dc"></circle><ellipse cx="0" cy="32" rx="24" ry="20" fill="#0049dc"></ellipse></g><circle r="36" fill="none" stroke="#0d0064" stroke-width="3"></circle></g>
          <g transform="translate(340 306)"><clipPath id="av4"><circle r="36"></circle></clipPath><circle r="36" fill="#0049dc"></circle><g clip-path="url(#av4)"><circle cx="0" cy="-7" r="12" fill="#ffffff"></circle><ellipse cx="0" cy="32" rx="24" ry="20" fill="#ffffff"></ellipse></g><circle r="36" fill="none"></circle></g>
        </svg>
    </div>
    <div style="flex: 999 1 560px; min-width: 0;">
      <p data-rv style="display: inline-block; margin: 0; padding: 4px 12px; border-radius: 48px; background: #ffc518; color: #232323; font-size: 16px; font-weight: 600; line-height: 1.4;">Voor wie</p>
      <h2 data-rv style="margin: 12px 0 0; font-size: clamp(40px, 3.125vw, 45px); line-height: 1; font-weight: 600; color: #0049dc;">Voor wie</h2>
      <ul data-rv class="oneline" style="margin: 32px 0 0; padding: 0; list-style: none; display: grid; gap: 12px; font-size: 18px; line-height: 1.4;">
          <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.750 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span>Organisaties waar design verspreid zit over afdelingen en tools</span></li>
          <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.750 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span>Teams die met AI willen werken zonder dat de kwaliteit wegzakt</span></li>
          <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.750 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span>Bedrijven die efficiënter willen werken, met orde en één goede basis</span></li>
          <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.750 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span>Iedereen die AI de snelheid wil laten doen en een senior de kwaliteitscheck</span></li>
        </ul>
    </div>
   </div>
    <svg class="tri" data-rv viewBox="0 0 295 157" aria-hidden="true" style="position: absolute; left: max(16px, calc(50% - 560px + 48px)); bottom: -78px; width: 220px; height: auto; z-index: 1;">
      <g transform="translate(5, 2)">
        <path fill="#ffc518" d="M167.1583,154.20702 L288.8703,22.67922 C289.4633,22.03892 289.0083,21.00002 288.1363,21.00002 L44.7122,21.00002 C43.8398,21.00002 43.3857,22.03892 43.9782,22.67922 L165.6903,154.20702 C166.0863,154.63502 166.7623,154.63502 167.1583,154.20702 Z"></path>
        <path fill="#0d0064" d="M243.423978,-2 L240.316226,1.35837881 L120.892226,130.413399 L119.424302,131.999705 L117.956376,130.413401 L-1.46792439,1.35838065 L-4.57568617,-2 L243.423978,-2 Z M234.273,2 L4.574,2 L119.424,126.11 L234.273,2 Z"></path>
      </g>
    </svg>
  </section>
  <section id="aanpak" style="background: #e3f0ff;">
   <div style="max-width: 1120px; margin: 0 auto; padding: clamp(140px, 12.5vw, 180px) 16px clamp(80px, 8vw, 117px);">
    <p data-rv style="display: inline-block; margin: 0; padding: 4px 12px; border-radius: 48px; background: #ffc518; color: #232323; font-size: 16px; font-weight: 600; line-height: 1.4;">Aanpak</p>
    <h2 data-rv style="margin: 12px 0 0; font-size: clamp(40px, 3.125vw, 45px); line-height: 1; font-weight: 600; color: #0049dc;">In vijf stappen</h2>
    <p data-rv style="margin: 12px 0 0; font-size: clamp(24px, 1.875vw, 27px); line-height: 1.1; font-weight: 400; color: #0d0064;">Naar efficiëntie en kwaliteit</p>

    <ol data-rv class="steps" data-steps aria-label="Vijf stappen" style="list-style: none; margin: 96px 0 0; padding: 0;">
      <li style="scroll-snap-align: start; display: flex; flex-direction: column; gap: 16px; min-width: 0;">
        <div style="display: flex; align-items: center;" aria-hidden="true"><span style="flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: #ffc518; color: #232323; font-size: 26px; font-weight: 600;">1</span><span style="flex: 1; height: 3px; margin-right: -24px; background: #0d0064;"></span></div>
        <button class="stepcard" type="button" data-step-open="1" aria-haspopup="dialog" aria-label="Meer over Scan" style="position: relative; flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin: 0; padding: 20px 20px 64px; border: 0; border-radius: 8px; background: #ffffff; color: #232323; font-family: Poppins, sans-serif; text-align: left; cursor: pointer;">
          <h3 style="margin: 0; font-size: clamp(24px, 1.95vw, 28px); line-height: 1.2; font-weight: 600; color: #0d0064;">Scan</h3>
          <p style="align-self: flex-start; margin: 0; padding: 2px 10px; border-radius: 48px; background: #e3f0ff; color: #0049dc; font-size: 14px; font-weight: 600; line-height: 1.4;">Eenmalig</p>
          <p style="margin: 0; font-size: 16px; line-height: 1.5;">In kaart brengen wat er al ligt: wat klopt, wat dubbel is en wat ontbreekt.</p>
          <span aria-hidden="true" style="position: absolute; right: 20px; bottom: 20px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #0049dc; color: #ffffff; font-size: 20px; font-weight: 600; line-height: 1;">+</span>
        </button>
      </li>
      <li style="scroll-snap-align: start; display: flex; flex-direction: column; gap: 16px; min-width: 0;">
        <div style="display: flex; align-items: center;" aria-hidden="true"><span style="flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: #ffc518; color: #232323; font-size: 26px; font-weight: 600;">2</span><span style="flex: 1; height: 3px; margin-right: -24px; background: #0d0064;"></span></div>
        <button class="stepcard" type="button" data-step-open="2" aria-haspopup="dialog" aria-label="Meer over Fundament" style="position: relative; flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin: 0; padding: 20px 20px 64px; border: 0; border-radius: 8px; background: #ffffff; color: #232323; font-family: Poppins, sans-serif; text-align: left; cursor: pointer;">
          <h3 style="margin: 0; font-size: clamp(24px, 1.95vw, 28px); line-height: 1.2; font-weight: 600; color: #0d0064;">Fundament</h3>
          <p style="align-self: flex-start; margin: 0; padding: 2px 10px; border-radius: 48px; background: #e3f0ff; color: #0049dc; font-size: 14px; font-weight: 600; line-height: 1.4;">Eenmalig</p>
          <p style="margin: 0; font-size: 16px; line-height: 1.5;">Eén bron van waarheid: huisstijl, design system en templates, gekoppeld aan je AI-tools.</p>
          <span aria-hidden="true" style="position: absolute; right: 20px; bottom: 20px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #0049dc; color: #ffffff; font-size: 20px; font-weight: 600; line-height: 1;">+</span>
        </button>
      </li>
      <li style="scroll-snap-align: start; display: flex; flex-direction: column; gap: 16px; min-width: 0;">
        <div style="display: flex; align-items: center;" aria-hidden="true"><span style="flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: #ffc518; color: #232323; font-size: 26px; font-weight: 600;">3</span><span style="flex: 1; height: 3px; margin-right: -24px; background: #0d0064;"></span></div>
        <button class="stepcard" type="button" data-step-open="3" aria-haspopup="dialog" aria-label="Meer over Overdracht" style="position: relative; flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin: 0; padding: 20px 20px 64px; border: 0; border-radius: 8px; background: #ffffff; color: #232323; font-family: Poppins, sans-serif; text-align: left; cursor: pointer;">
