<style is:global>
.consultancy { font-family: Poppins, sans-serif; color: #232323; }
.consultancy a { color: #0d0064; }
.consultancy p, .consultancy h1, .consultancy h2, .consultancy h3, .consultancy ul, .consultancy ol { letter-spacing: normal; }
.steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:56px 24px;position:relative}
.steps-loop{display:block}
@media (min-width:1100px){.oneline span{white-space:nowrap}}
.steps-mobile{display:none}
@media (max-width:1000px){.why-dots{display:none}}
@media (max-width:760px){
.steps{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:72%;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;margin:56px -16px 0 !important;padding:0 16px 8px !important;scroll-padding:0 16px;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 0,#000 70%,transparent 100%);mask-image:linear-gradient(90deg,#000 0,#000 70%,transparent 100%);transition:-webkit-mask-image .3s}
.steps::-webkit-scrollbar{display:none}
.steps.is-end{-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 12%,#000 100%);mask-image:linear-gradient(90deg,transparent 0,#000 12%,#000 100%)}
.steps.is-mid{-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 10%,#000 72%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 10%,#000 72%,transparent 100%)}
.steps-loop{display:none}
.steps-mobile{display:flex}
}

.label-navy { background: #0d0064 !important; color: #ffffff !important; }
</style>

<script>
  const steps = document.querySelector<HTMLElement>('[data-steps]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  if (steps) {
    const update = () => {
      const max = steps.scrollWidth - steps.clientWidth;
      const step = max > 0 ? Math.round((steps.scrollLeft / max) * 4) : 0;
      steps.classList.toggle('is-end', max > 0 && steps.scrollLeft > max - 8);
      steps.classList.toggle('is-mid', steps.scrollLeft >= 8 && steps.scrollLeft <= max - 8);
      dots.forEach((d, i) => {
        d.style.width = i === step ? '28px' : '8px';
        d.style.background = i === step ? '#0049dc' : '#c7ddff';
      });
    };
    steps.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
