  .slide { transition: opacity .42s cubic-bezier(.16,1,.3,1), translate .42s cubic-bezier(.16,1,.3,1); }
  .slide.is-leaving { opacity: 0; translate: calc(var(--dir, 1) * -32px) 0; }
  .slide.is-entering { opacity: 0; translate: calc(var(--dir, 1) * 32px) 0; transition: none; }
  .slide.is-active { opacity: 1; translate: 0 0; }
}
@media (max-width: 600px) {
  .slidenav { margin-top: 20px; }
  .slidenav [role="tab"] { padding: 7px 12px; font-size: 14px; white-space: nowrap; }
  .slides { margin-top: 22px; }
  .slidefoot { margin-top: 24px; padding-top: 18px; }
  .slidebtn--done { font-size: 15px; padding: 0 14px; }
}
.stepdialog::backdrop { background: rgba(13, 0, 100, 0.55); }
.stepdialog__inner { position: static; box-sizing: border-box; height: auto; min-height: min(440px, calc(100dvh - 48px)); max-height: calc(100dvh - 48px); padding: clamp(24px, 3vw, 40px) clamp(28px, 4vw, 48px); }
.stepdialog h3, .stepdialog h4, .stepdialog p, .stepdialog ul { letter-spacing: normal; }
@media (prefers-reduced-motion: no-preference) {
  .stepdialog[open] { animation: dialog-in 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes dialog-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
}

/* --- Pop-up v2: zo hoog als de inhoud, pijlen naast de pop-up, stippen onderaan --- */
.stepdialog { height: fit-content; max-height: calc(100dvh - 48px); margin: auto; overflow: visible; }
.slidefoot { margin-top: auto; padding-top: 28px; border-top: 0; }
.slidedots { position: relative; display: flex; justify-content: center; align-items: center; gap: 8px; margin: 0 auto; width: max-content; }
.slidedots span { display: block; width: 10px; height: 10px; border-radius: 10px; background: #e3f0ff; cursor: pointer; transition: width .5s cubic-bezier(.65,0,.35,1); }
.slidedots span.is-on { width: 32px; }
/* De blauwe streep loopt als een rups naar de volgende stip: de voorkant rekt eerst uit, de achterkant volgt. */
.slidedots__bar { position: absolute; top: 0; bottom: 0; left: var(--l, 0px); right: var(--r, 0px); border-radius: 10px; background: #0049dc; pointer-events: none; }
.slidedots.is-ready .slidedots__bar { transition: left .42s cubic-bezier(.65,0,.35,1) var(--dl, 0s), right .42s cubic-bezier(.65,0,.35,1) var(--dr, 0s); }
/* Tabs: de blauwe pil schuift soepel naar het gekozen tabblad. */
.slidenav { position: relative; }
.slidenav__bar { position: absolute; z-index: 0; top: 5px; bottom: 5px; left: 0; width: 0; border-radius: 48px; background: #0049dc; box-shadow: 0 2px 6px rgba(0,73,220,.25); pointer-events: none; }
.slidenav.is-ready .slidenav__bar { transition: transform .5s cubic-bezier(.65,0,.35,1), width .5s cubic-bezier(.65,0,.35,1); }
.slidenav [role="tab"] { position: relative; z-index: 1; transition: color .35s ease .1s, background .25s ease; }
.slidenav.has-bar [role="tab"][aria-selected="true"] { background: transparent; box-shadow: none; }
.slidenav [role="tab"][aria-selected="true"]:hover { background: transparent; }
/* Nooit een scrollbalk in de pop-up (scrollen kan wel; onderaan vervaagt de tekst als er meer staat). */
.stepdialog, .stepdialog * { scrollbar-width: none; }
.stepdialog::-webkit-scrollbar, .stepdialog *::-webkit-scrollbar { display: none; width: 0; height: 0; }
.slides-scroll { overflow-x: hidden; }
.slidefoot { flex-wrap: wrap; }
.slidehint { flex-basis: 100%; grid-column: 1 / -1; margin: 14px 0 0; text-align: center; font-size: 14px; line-height: 1.4; color: #0d0064; opacity: 0; translate: 0 4px; transition: opacity .4s ease .5s, translate .4s cubic-bezier(.16,1,.3,1) .5s; }
.slidehint.is-shown { opacity: 1; translate: none; }
.slidehint[hidden] { display: none; }
.slidehint kbd { display: inline-grid; place-items: center; min-width: 24px; height: 24px; margin: 0 1px; padding: 0 5px; border-radius: 6px; background: #e3f0ff; box-shadow: inset 0 -2px 0 #c2d9f7; font-family: Poppins, sans-serif; font-size: 16px; font-weight: 600; line-height: 1; color: #0d0064; }
@media (prefers-reduced-motion: reduce) { .slidenav.is-ready .slidenav__bar, .slidedots.is-ready .slidedots__bar, .slidedots span { transition: none; } }
.vh { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.slidebtn--done { white-space: nowrap; }
/* Lopende tekst overal gelijk: 17px, 1.6, ink */
.pop-lead, .pop-tl p, .pop-res li, .pb { font-size: 17px; line-height: 1.6; color: #232323; }
.pop-res strong { color: #0d0064; }
.pop-quote { font-size: clamp(20px, 2vw, 26px); line-height: 1.4; }
/* Breed scherm: vorige en volgende staan naast de pop-up, in het midden van het scherm (de pop-up staat zelf in het midden, dus 50% is altijd dezelfde plek). */
@media (min-width: 1200px) {
  .slidefoot { display: flex; justify-content: center; }
  .slidefoot .slidebtn { position: absolute; top: 50%; translate: 0 -50%; min-width: 56px; min-height: 56px; border-radius: 16px; }
  .slidefoot .slidebtn--prev { right: calc(100% + 28px); left: auto; }
  .slidefoot .slidebtn--next, .slidefoot .slidebtn--done { left: calc(100% + 28px); right: auto; }
}
