/* In een pop-up staat de vraagteken-knop vaak rechts: ballon naar links laten uitklappen */
/* De inhoud van een pop-up scrolt en knipt alles erboven af: daar klapt de tooltip naar beneden en naar links uit */
dialog .info-tip .tip__bubble { left: auto; right: -12px; top: calc(100% + 6px); bottom: auto; transform: none; translate: 0 -4px; transform-origin: 100% 0; }
dialog .info-tip.tip--from-left .tip__bubble { left: -12px; right: auto; transform-origin: 0 0; }
.stepdialog { width: min(100% - 32px, 760px); height: calc(100dvh - 48px); max-height: calc(100dvh - 48px); margin: 24px auto; padding: 0; overflow: hidden; border: 0; border-radius: 8px; background: #ffffff; color: #232323; font-family: Poppins, sans-serif; letter-spacing: normal; }
