.steps.is-mid{-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 10%,#000 72%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 10%,#000 72%,transparent 100%)}
.steps-loop{display:none}
.steps-mobile{display:flex}
}

/* --- Animaties: zelfde ritme als de homepage (zacht omhoog, 0,8 s, korte stagger) --- */
@media (prefers-reduced-motion: no-preference) {
  html.js [data-rv]:not(.ill):not(.tri):not(.steps):not(.flow-wrap) { opacity: 0; translate: 0 18px; transition: opacity .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), translate .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms); }
  html.js [data-rv]:not(.ill):not(.tri):not(.steps):not(.flow-wrap).is-revealed { opacity: 1; translate: none; }
  html.js .contact-copy[data-rv] { transition: opacity .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), translate .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), box-shadow .3s ease-out, transform .3s ease-out; }

  /* Illustraties: iets groter worden en infaden */
  html.js .ill { opacity: 0; scale: .94; transition: opacity 1s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), scale 1s cubic-bezier(.16,1,.3,1) var(--rd, 0ms); }
  html.js .ill.is-revealed { opacity: 1; scale: 1; }

  /* Hero-illustratie: losse vormen komen na elkaar, de stippen en het vinkje veren erin */
  .hero-ill .hi-float, .hero-ill .hi-pop, .hero-ill .hi-fade { transform-box: fill-box; transform-origin: center; }
  html.js .hero-ill .hi-float { opacity: 0; translate: 0 14px; }
  html.js .hero-ill .hi-pop { opacity: 0; scale: .3; }
  html.js .hero-ill .hi-fade { opacity: 0; }
  .ill.is-revealed .hero-ill .hi-float { animation: hi-float .9s cubic-bezier(.16,1,.3,1) var(--fd, 0s) both; }
  .ill.is-revealed .hero-ill .hi-pop { animation: hi-pop .6s cubic-bezier(.34,1.56,.64,1) var(--fd, 0s) both; }
  .ill.is-revealed .hero-ill .hi-fade { animation: hi-fade .8s ease-out 1.1s both; }
  @keyframes hi-float { to { opacity: 1; translate: 0 0; } }
  @keyframes hi-pop { to { opacity: 1; scale: 1; } }
  @keyframes hi-fade { to { opacity: 1; } }

  /* Driehoekjes: schuiven één keer naar beneden en veren terug (zoals op de homepage) */
  .tri path { transform-box: fill-box; }
  .tri.is-revealed path { animation: arrow-nudge 1.1s cubic-bezier(.37,0,.63,1) both; }
  .tri.is-revealed path + path { animation-delay: .14s; }

  /* Gele cirkels tekenen zichzelf in, nadat de zin er staat */
  html.js .qk path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .is-revealed .qk path { animation: qk-draw .9s cubic-bezier(.65,0,.35,1) .6s both; }
  .is-revealed .qk:nth-of-type(2) path { animation-delay: 1.3s; }
  @keyframes qk-draw { to { stroke-dashoffset: 0; } }
  .stepdialog .slide.is-active .qk path { animation: qk-draw .9s cubic-bezier(.65,0,.35,1) .35s both; }
  .stepdialog .slide.is-active .qk:nth-of-type(2) path { animation-delay: 1s; }
  .stepdialog .slide.is-active .qk:nth-of-type(3) path { animation-delay: 1.65s; }

  /* Vijf stappen: nummers veren op, lijnen groeien, kaarten komen omhoog */
  .steps > li:nth-child(1) { --n: 0; } .steps > li:nth-child(2) { --n: 1; } .steps > li:nth-child(3) { --n: 2; } .steps > li:nth-child(4) { --n: 3; } .steps > li:nth-child(5) { --n: 4; }
  html.js .steps > li > div > span:first-child { opacity: 0; scale: .4; }
  html.js .steps > li > div > span + span { opacity: 0; scale: 0 1; transform-origin: left center; }
  html.js .steps .stepcard { opacity: 0; translate: 0 20px; }
  html.js .steps-loop { opacity: 0; }
  .steps.is-revealed > li > div > span:first-child { animation: hi-pop .6s cubic-bezier(.34,1.56,.64,1) calc(var(--n) * 150ms) both; }
  .steps.is-revealed > li > div > span + span { animation: step-line .5s cubic-bezier(.16,1,.3,1) calc(var(--n) * 150ms + 200ms) both; }
  html.js .steps.is-revealed .stepcard { opacity: 1; translate: none; transition: opacity .8s cubic-bezier(.16,1,.3,1) calc(var(--n) * 120ms + 350ms), translate .8s cubic-bezier(.16,1,.3,1) calc(var(--n) * 120ms + 350ms), transform .25s cubic-bezier(.16,1,.3,1); }
  .steps.is-revealed .steps-loop { animation: hi-fade .3s ease-out 1.1s both; }
  html.js .steps-loop__arc { clip-path: inset(0 0 0 100%); }
  .steps.is-revealed .steps-loop__arc { animation: loop-draw .9s cubic-bezier(.65,0,.35,1) 1.15s both; }
  @keyframes loop-draw { to { clip-path: inset(0 0 0 0); } }
  html.js .steps-loop__head { opacity: 0; }
  .steps.is-revealed .steps-loop__head { animation: hi-fade .3s ease-out 1.95s both; }
  @keyframes step-line { to { opacity: 1; scale: 1 1; } }

  /* Stippellijnen bij De scan "stromen" naar de resultaatkaart */
  html.js .flow-wrap svg { clip-path: inset(0 0 100% 0); transition: clip-path .9s cubic-bezier(.65,0,.35,1) .2s; }
  html.js .flow-wrap.is-revealed svg { clip-path: inset(0 0 0 0); }
  .scan-result { --rd: 600ms; }
}
@media print { html.js [data-rv], html.js .hero-ill *, html.js .steps * , html.js .qk path { opacity: 1 !important; translate: none !important; scale: none !important; clip-path: none !important; stroke-dashoffset: 0 !important; } }

