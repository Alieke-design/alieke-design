<script>
  // Na de eerste animatie: bij hover gaan de onderdelen weer uit het kader, bij weggaan terug.
  const whyWrap = document.querySelector('.why-wrap');
  if (whyWrap) {
    const arm = () => { if (whyWrap.classList.contains('is-revealed') && !whyWrap.classList.contains('ready')) setTimeout(() => whyWrap.classList.add('ready'), 3200); };
    new MutationObserver(arm).observe(whyWrap, { attributes: true, attributeFilter: ['class'] });
    arm();
  }
</script>

<script>
  // Tooltips in een pop-up: naar links of rechts uitklappen, afhankelijk van waar het vraagteken staat.
  document.querySelectorAll<HTMLElement>('dialog .info-tip').forEach((tip) => {
    const side = () => {
      const box = tip.closest('dialog')!.getBoundingClientRect();
      const r = tip.getBoundingClientRect();
      tip.classList.toggle('tip--from-left', r.left - box.left < box.width / 2);
    };
    tip.addEventListener('pointerenter', side);
    tip.addEventListener('focus', side);
  });
</script>
