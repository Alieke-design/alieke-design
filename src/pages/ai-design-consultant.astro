.qk{position:relative;isolation:isolate;display:inline-block;margin:0 .3em 0 .26em}.qk svg{position:absolute;z-index:-1;left:-.5em;top:-.26em;width:calc(100% + 1em);height:calc(100% + .52em);overflow:visible;pointer-events:none}.qk path{fill:none;stroke:#ffc518;stroke-width:4;stroke-linecap:round;vector-effect:non-scaling-stroke}
