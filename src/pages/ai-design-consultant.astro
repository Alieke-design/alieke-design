---
import Base from '../layouts/Base.astro';
import PauseButton from '../components/PauseButton.astro';
import { site } from '../config';

const nav = [
  { href: '#waarom', label: 'Waarom' },
  { href: '#aanpak', label: 'Aanpak' },
  { href: '#wat-je-krijgt', label: 'Resultaat' },
  { href: '#scan', label: 'Stap 1' },
  { href: '#contact', label: 'Contact' },
];
// Pop-ups achter de stappen tijdelijk uit (nog niet af). Zet op true om ze weer aan te zetten.
const popupsOn = false;
---
<Base
  title="AI Design Consultant - Alieke.design"
  description="Eén designbasis voor de hele organisatie, klaar om zelf met AI mee te werken. Met beheer en review door een senior designer."
  ogImage="/og-consultant.png"
  ogImageAlt="AI Design Consultant Alieke Zelhorst"
  nav={nav}
  menuNote="Je krijgt binnen een werkdag reactie."
>
<div class:list={["consultancy", { "no-popups": !popupsOn }]} data-popups={popupsOn ? "on" : "off"}>
  <section id="hi" class="hero-under-header" data-header-theme="light" style="background: #e3f0ff;">
   <div style="max-width: var(--wrap); margin: 0 auto; padding: calc(clamp(40px, 6vw, 96px) + 40px) var(--gut) calc(clamp(64px, 8vw, 117px) + 40px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px 64px;">
    <div style="flex: 1 1 560px; min-width: 0; max-width: 640px;">
      <p data-rv style="display: inline-block; margin: 0; padding: 4px 12px; border-radius: 48px; background: #ffc518; color: #232323; font-size: 16px; font-weight: 600; line-height: 1.4;">AI Design Consultant</p>
      <h1 data-rv style="margin: 16px 0 0; font-size: clamp(40px, 4.2vw, 60px); line-height: 1.05; letter-spacing: -0.01em; font-weight: 600; color: #0d0064;">Je designproces, <span style="white-space: nowrap;">klaar voor AI</span></h1>
      <p data-rv style="margin: 24px 0 0; font-size: clamp(20px, 1.6vw, 22px); line-height: 1.35; font-weight: 400; color: #232323;">Ik breng het proces in je organisatie:</p>
      <ul data-rv style="margin: 24px 0 0; padding: 0; list-style: none; display: grid; gap: 14px; font-size: 18px; line-height: 1.45;">
        <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.75 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span><strong style="font-weight: 600;">op orde:</strong> van losse bestanden naar een bron van waarheid</span></li>
        <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.75 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span><strong style="font-weight: 600;">op eigen kracht:</strong> elk team ontwerpt snel en on-brand met AI</span></li>
        <li style="display: flex; gap: 12px;"><svg viewBox="0 0 448 512" aria-hidden="true" style="flex: none; width: 18px; height: 25px; fill: #0049dc;"><path d="M264.6 70.63l176 168c4.75 4.531 7.438 10.81 7.438 17.38s-2.688 12.84-7.438 17.38l-176 168c-9.594 9.125-24.78 8.781-33.94-.8125c-9.156-9.5-8.812-24.75 .8125-33.94l132.7-126.6H24.01c-13.25 0-24.01-10.76-24.01-24.01s10.76-23.99 24.01-23.99h340.1l-132.7-126.6C221.8 96.23 221.5 80.98 230.6 71.45C239.8 61.85 254.1 61.51 264.6 70.63z"></path></svg><span><strong style="font-weight: 600;">op niveau:</strong> beheer van de bron en review van complex werk</span></li>
      </ul>
      <a data-rv href="#aanpak" style="display: inline-flex; align-items: center; gap: 10px; margin-top: 40px; padding: 17.8px 28.3px; border-radius: 14.08px; background: #0049dc; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none; box-shadow: 3.52px -3.52px 0 0 #232323;">Bekijk de aanpak<svg viewBox="0 0 14 15" aria-hidden="true" style="width: 13px; height: 14px; fill: #ffffff;"><path d="M6.28125 13.7188L1.28125 8.71875C0.875 8.34375 0.875 7.6875 1.28125 7.3125C1.65625 6.90625 2.3125 6.90625 2.6875 7.3125L6 10.5938V1C6 0.46875 6.4375 0 7 0C7.53125 0 8 0.46875 8 1V10.5938L11.2812 7.3125C11.6562 6.90625 12.3125 6.90625 12.6875 7.3125C13.0938 7.6875 13.0938 8.34375 12.6875 8.71875L7.6875 13.7188C7.3125 14.125 6.65625 14.125 6.28125 13.7188Z"></path></svg></a>
    </div>

    <div class="ill has-pause" data-rv style="position: relative; flex: 1 1 480px; max-width: 700px; min-width: 0; margin: 0 0 0 auto;">
      <svg class="hero-flow" data-motion-smil viewBox="0 0 526 450" role="img" aria-label="Links één bron, beheerd door Alieke. Daaruit putten de teams, die met AI ontwerpen maken: Development een applicatie en een dashboard, Marketing een landingspagina en een e-mail, Sales een presentatie en een offerte, en HR een onboarding en een vacaturepagina. Complex werk krijgt op aanvraag een review, en wat daar opvalt verwerkt Alieke in de bron." style="display: block; width: 100%; height: auto; overflow: visible;">
