<script>
  // Pop-ups uit: triggers worden gewone, niet-klikbare elementen.
  if (document.querySelector('.consultancy')?.getAttribute('data-popups') === 'off') {
    document.querySelectorAll<HTMLElement>('[data-step-open]').forEach((b) => {
      b.removeAttribute('data-step-open'); b.removeAttribute('aria-haspopup'); b.removeAttribute('aria-label');
      b.setAttribute('role', 'none'); b.tabIndex = -1;
    });
  }
  const steps = document.querySelector<HTMLElement>('[data-steps]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  if (steps) {
    const update = () => {
      const max = steps.scrollWidth - steps.clientWidth;
      const step = max > 0 ? Math.round((steps.scrollLeft / max) * 4) : 0;
      steps.classList.toggle('is-end', max > 0 && steps.scrollLeft > max - 8);
      steps.classList.toggle('is-mid', steps.scrollLeft >= 8 && steps.scrollLeft <= max - 8);
      dots.forEach((d, i) => {
        d.style.width = i === step ? '28px' : '8px';
        d.style.background = i === step ? '#0049dc' : '#c7ddff';
      });
    };
    steps.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Alles komt zacht in beeld zodra je erbij scrolt (zelfde ritme als de homepage).
  const rvTargets = [...document.querySelectorAll<HTMLElement>('[data-rv]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    rvTargets.forEach((el) => el.classList.add('is-revealed'));
  } else {
    const io = new IntersectionObserver((entries) => {
      let i = 0;
      entries.filter((e) => e.isIntersecting).forEach((e) => {
        const el = e.target as HTMLElement;
        if (!el.style.getPropertyValue('--rd')) el.style.setProperty('--rd', `${Math.min(i++, 4) * 80}ms`);
        el.classList.add('is-revealed');
        io.unobserve(el);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
    rvTargets.forEach((el) => io.observe(el));
  }

  // Presentatie in de pop-up: tabs, pijlen, toetsen en swipen.
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const decks = new Map<HTMLDialogElement, { go: (i: number, focusTab?: boolean) => void; cur: () => number; total: number; snap: () => void }>();
  document.querySelectorAll<HTMLDialogElement>('.stepdialog').forEach((dialog) => {
    const tabs = [...dialog.querySelectorAll<HTMLButtonElement>('[data-slide-tab]')];
    const slides = [...dialog.querySelectorAll<HTMLElement>('.slide')];
    const bar = dialog.querySelector<HTMLElement>('.slidenav__bar');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-slide-next]');
    const done = dialog.querySelector<HTMLButtonElement>('[data-step-next]');
    const dotEls = [...dialog.querySelectorAll<HTMLElement>('[data-slide-dot]')];
    const live = dialog.querySelector<HTMLElement>('[data-slide-live]');
    let announced = false;
    const track = dialog.querySelector<HTMLElement>('[data-slides-track]');
    const scroller = dialog.querySelector<HTMLElement>('.slides-scroll');
    const total = slides.length;
    // Geen scrollbalk: onderaan vervaagt de tekst zolang er nog meer staat.
    const fade = () => { if (!scroller) return; scroller.classList.toggle('has-more', scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 4); };
    scroller?.addEventListener('scroll', fade, { passive: true });
    if (track && 'ResizeObserver' in window) new ResizeObserver(fade).observe(track);
    window.addEventListener('resize', fade);
    const stepNo = Number(dialog.id.replace('step-', ''));
    const prevDialog = document.querySelector<HTMLDialogElement>(`#step-${stepNo - 1}`);
    const prevName = prevDialog?.querySelector('h3')?.textContent?.trim();
    let cur = 0, settle = 0;
    const nav = dialog.querySelector<HTMLElement>('.slidenav');
    const dotsBox = dialog.querySelector<HTMLElement>('.slidedots');
    const dotBar = dialog.querySelector<HTMLElement>('.slidedots__bar');
    let dotAt = 0;
    // Eenmalige tip op desktop: je kunt ook de pijltjestoetsen gebruiken.
    const hint = dialog.querySelector<HTMLElement>('[data-slide-hint]');
    const hideHint = (used = false) => {
      if (!hint || hint.hidden) return;
      hint.classList.remove('is-shown');
      window.setTimeout(() => { hint.hidden = true; }, 300);
      if (used) { try { localStorage.setItem('ad-pijltip', '1'); } catch {} }
    };
    dialog.addEventListener('close', () => hideHint());
    // snap = zonder animatie (bij openen); anders schuift de pil/streep soepel mee.
    const placeBar = (snap = false) => {
      const t = tabs[cur]; if (!bar || !t || !nav) return;
      if (!t.offsetWidth) return; // pop-up nog dicht: niets te meten
      if (snap) nav.classList.remove('is-ready');
      nav.classList.add('has-bar');
      bar.style.width = `${t.offsetWidth}px`;
      bar.style.transform = `translateX(${t.offsetLeft}px)`;
      if (snap) { void bar.offsetWidth; }
      nav.classList.add('is-ready');
    };
    const placeDots = (snap = false) => {
      if (!dotsBox || !dotBar) return;
      // Vaste maten: stip 10px, actieve 32px, tussenruimte 8px.
      const left = cur * 18, right = (total - 1 - cur) * 18;
      const fwd = cur > dotAt;
      if (snap) dotsBox.classList.remove('is-ready');
      dotBar.style.setProperty('--dl', snap || cur === dotAt ? '0s' : fwd ? '.12s' : '0s');
      dotBar.style.setProperty('--dr', snap || cur === dotAt ? '0s' : fwd ? '0s' : '.12s');
      dotBar.style.setProperty('--l', `${left}px`);
      dotBar.style.setProperty('--r', `${right}px`);
      if (snap) { void dotBar.offsetWidth; }
      dotsBox.classList.add('is-ready');
      dotAt = cur;
    };
    const go = (i: number, focusTab = false) => {
      i = Math.max(0, Math.min(total - 1, i));
      const dir = i > cur ? 1 : -1;
      const from = slides[cur], to = slides[i];
      if (i !== cur) {
        dialog.style.setProperty('--dir', String(dir));
        from.classList.remove('is-active');
        if (prefersReduce || !track) {
          from.hidden = true;
          to.hidden = false;
        } else {
          // Hoogte van de oude naar de nieuwe dia laten glijden; de oude schuift uit, de nieuwe in.
          const h0 = track.offsetHeight;
          track.style.height = `${h0}px`;
          from.classList.add('is-leaving');
          to.hidden = false;
          to.classList.add('is-entering');
          const h1 = to.offsetHeight;
          void track.offsetWidth;
          track.style.height = `${h1}px`;
          to.classList.remove('is-entering');
          window.clearTimeout(settle);
          settle = window.setTimeout(() => {
            from.hidden = true; from.classList.remove('is-leaving');
            slides.forEach((sl) => { if (sl !== slides[cur]) { sl.hidden = true; sl.classList.remove('is-leaving'); } });
            track.style.height = '';
          }, 460);
        }
        to.classList.add('is-active');
        cur = i;
        scroller?.scrollTo({ top: 0, behavior: prefersReduce ? 'auto' : 'smooth' });
      }
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === cur)); t.tabIndex = k === cur ? 0 : -1; });
      if (focusTab) tabs[cur]?.focus();
      if (prev) {
        prev.disabled = cur === 0 && !prevDialog;
        prev.setAttribute('aria-label', cur === 0 && prevName ? `Vorige stap: ${prevName}` : 'Vorige');
      }
      const last = cur === total - 1;
      const hadFocus = document.activeElement;
      if (next) next.hidden = last;
      if (done) done.hidden = !last;
      // Verdwijnt de knop die focus had, dan gaat de focus naar zijn vervanger (anders raak je 'm kwijt).
      if (hadFocus === next && last) done?.focus();
      else if (hadFocus === done && !last) next?.focus();
      else if (hadFocus === prev && cur === 0) next?.focus();
      dotEls.forEach((d, k) => d.classList.toggle('is-on', k === cur));
      // Schermlezer hoort welke dia er staat (niet bij het openen zelf).
      if (live) { if (announced) live.textContent = `${tabs[cur]?.textContent?.trim() ?? ''}, dia ${cur + 1} van ${total}`; announced = true; }
      placeBar();
      placeDots();
    };
    tabs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    dotEls.forEach((d, k) => d.addEventListener('click', () => go(k)));
    prev?.addEventListener('click', () => {
      if (cur > 0) { go(cur - 1); return; }
      if (!prevDialog) return;
      // Eerste dia: terug naar de laatste dia van de vorige stap.
      prevDialog.dataset.openAt = 'last';
      dialog.close();
      document.querySelector<HTMLButtonElement>(`[data-step-open="${stepNo - 1}"]`)?.click();
    });
    next?.addEventListener('click', () => go(cur + 1));
    done?.addEventListener('click', () => {
      const n = Number(done.dataset.stepNext);
      dialog.close();
      if (n) document.querySelector<HTMLButtonElement>(`[data-step-open="${n}"]`)?.click();
    });
    // Eén stap verder of terug; voorbij de laatste/eerste dia ga je door naar de volgende/vorige stap.
    // Geeft true terug als er naar een andere pop-up is gewisseld.
    const stepBy = (d: 1 | -1, focusTab = false) => {
      if (d === 1 && cur === total - 1) {
        if (done && done.dataset.stepNext && done.dataset.stepNext !== '0') { done.click(); return true; }
        return false;
      }
      if (d === -1 && cur === 0) {
        if (prevDialog) { prev?.click(); return true; }
        return false;
      }
      go(cur + d, focusTab);
      return false;
    };
    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        hideHint(true);
        // Bij een wissel naar een andere pop-up mag die dezelfde toetsaanslag niet ook nog verwerken.
        if (stepBy(e.key === 'ArrowRight' ? 1 : -1, document.activeElement?.hasAttribute('data-slide-tab'))) e.stopImmediatePropagation();
        return;
      }
      if (e.key === 'Home') { e.preventDefault(); go(0); }
      if (e.key === 'End') { e.preventDefault(); go(total - 1); }
    });
    // Swipen op touch
    let sx = 0, sy = 0, swiping = false;
    dialog.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; sx = e.clientX; sy = e.clientY; swiping = true; });
    dialog.addEventListener('pointerup', (e) => {
      if (!swiping) return; swiping = false;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) stepBy(dx < 0 ? 1 : -1);
    });
    dialog.addEventListener('pointercancel', () => { swiping = false; });
    decks.set(dialog, { go, cur: () => cur, total, snap: () => { placeBar(true); placeDots(true); } });
    window.addEventListener('resize', () => { if (dialog.open) { placeBar(true); placeDots(true); } });
    go(0);
  });

  // Lus 4↔5: elke keer dat de stappen in beeld komen, loopt er één gele stip langs de lus (2,4 s).
  const loop = document.querySelector<HTMLElement>('.steps-loop');
  const motion = loop?.querySelector<SVGAnimateMotionElement>('[data-flow-motion]');
  const fade = loop?.querySelector<SVGAnimateElement>('[data-flow-fade]');
  if (loop && motion && fade && !reduce && 'IntersectionObserver' in window && getComputedStyle(loop).display !== 'none') {
    const setPath = () => {
      const w = loop.offsetWidth, h = loop.offsetHeight, o = 8, r = 28.5, i = 1.5;
      motion.setAttribute('path', `M${w - i + o} ${h + o} L${w - i + o} ${r + o} A${r} ${r} 0 0 0 ${w - i - r + o} ${i + o} L${i + r + o} ${i + o} A${r} ${r} 0 0 0 ${i + o} ${r + o} L${i + o} ${h + o - 2}`);
    };
    setPath();
    window.addEventListener('resize', setPath);
    // Zolang de stappen in beeld zijn, komt de stip onregelmatig terug:
    // na elke ronde (2,4 s) een pauze van willekeurig 5 tot 10 seconden.
    let first = true, timer = 0;
    const play = () => { if (document.documentElement.classList.contains('motion-paused')) return; setPath(); (motion as any).beginElement(); (fade as any).beginElement(); };
    const next = () => {
      timer = window.setTimeout(() => { if (!document.hidden) play(); next(); }, 2400 + 5000 + Math.random() * 5000);
    };
    const lio = new IntersectionObserver((entries) => entries.forEach((e) => {
      window.clearTimeout(timer);
      if (!e.isIntersecting) return;
      timer = window.setTimeout(() => { play(); next(); }, first ? 2300 : 600);
      first = false;
    }), { threshold: 0.6 });
    lio.observe(loop);
  }

  // Lijnen bij De scan: lopen af en toe naar het resultaat, net als de stip bij stap 4-5.
  const flowWrap = document.querySelector<HTMLElement>('.flow-wrap');
  if (flowWrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ftimer = 0, ffirst = true;
    const run = () => {
      if (document.documentElement.classList.contains('motion-paused') || document.hidden) return;
      flowWrap.classList.remove('flow-run'); void flowWrap.offsetWidth; flowWrap.classList.add('flow-run');
    };
    flowWrap.addEventListener('animationend', (e) => { if ((e.target as Element).classList.contains('flow-draw--3')) flowWrap.classList.remove('flow-run'); });
    const nextFlow = () => { ftimer = window.setTimeout(() => { run(); nextFlow(); }, 4400 + 6000 + Math.random() * 6000); };
    new IntersectionObserver((entries) => entries.forEach((e) => {
      window.clearTimeout(ftimer);
      if (!e.isIntersecting) return;
      ftimer = window.setTimeout(() => { run(); nextFlow(); }, ffirst ? 900 : 600);
      ffirst = false;
    }), { threshold: 0.6 }).observe(flowWrap);
  }

  // De lichtblauwe hero loopt door tot achter de (witte) header, zonder witte strook ertussen.
  const hdr = document.querySelector<HTMLElement>('.header');
  const heroUnder = document.querySelector<HTMLElement>('.hero-under-header');
  if (hdr && heroUnder) {
    const fitHero = () => { const h = hdr.offsetHeight; heroUnder.style.marginTop = `-${h}px`; heroUnder.style.paddingTop = `${h}px`; };
    fitHero();
    window.addEventListener('resize', fitHero);
  }

  // Pop-ups per stap: native <dialog> (focus blijft erin, Escape of het kruisje sluit).
  // De pagina erachter wordt vastgezet (ook op iOS), zodat je in de pop-up scrolt.
  let lockedY = 0;
  const touchLock = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  document.querySelectorAll<HTMLButtonElement>('[data-step-open]').forEach((btn) => {
    const dialog = document.querySelector<HTMLDialogElement>(`#step-${btn.dataset.stepOpen}`);
    if (!dialog) return;
    btn.addEventListener('click', () => {
      lockedY = window.scrollY;
      window.dispatchEvent(new Event('lenis:stop'));
      dialog.showModal();
      const deck = decks.get(dialog);
      const at = dialog.dataset.openAt === 'last' && deck ? deck.total - 1 : 0;
      delete dialog.dataset.openAt;
      if (deck) { deck.go(at); deck.snap(); requestAnimationFrame(() => deck.snap()); }
      // Tip alleen op een computer met muis, en alleen tot je de pijltjes één keer hebt gebruikt.
      let seen = false; try { seen = localStorage.getItem('ad-pijltip') === '1'; } catch {}
      const hint = dialog.querySelector<HTMLElement>('[data-slide-hint]');
      if (hint && !seen && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        hint.hidden = false;
        requestAnimationFrame(() => hint.classList.add('is-shown'));
      }
      document.documentElement.style.overflow = 'hidden';
      // Op touch-apparaten (iOS) helpt overflow:hidden niet; daar zetten we de pagina letterlijk vast.
      if (touchLock) Object.assign(document.body.style, { position: 'fixed', top: `-${lockedY}px`, left: '0', right: '0', width: '100%', overflow: 'hidden' });
    });
    dialog.querySelectorAll('[data-step-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    // Naast de pop-up klikken sluit hem niet (je mist makkelijk een pijl). Sluiten: kruisje of Escape.
    dialog.addEventListener('close', () => { window.dispatchEvent(new Event('lenis:start')); document.documentElement.style.overflow = ''; if (touchLock) { Object.assign(document.body.style, { position: '', top: '', left: '', right: '', width: '', overflow: '' }); window.scrollTo(0, lockedY); } btn.focus(); });
  });
</script>

