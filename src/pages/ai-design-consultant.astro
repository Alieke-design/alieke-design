/* --- Animaties: zelfde ritme als de homepage (zacht omhoog, 0,8 s, korte stagger) --- */
@media (prefers-reduced-motion: no-preference) {
  html.js [data-rv]:not(.ill):not(.tri):not(.steps):not(.flow-wrap) { opacity: 0; translate: 0 18px; transition: opacity .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), translate .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms); }
  html.js [data-rv]:not(.ill):not(.tri):not(.steps):not(.flow-wrap).is-revealed { opacity: 1; translate: none; }
  html.js .contact-copy[data-rv] { transition: opacity .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), translate .8s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), box-shadow .3s ease-out, transform .3s ease-out; }

  /* Illustraties: iets groter worden en infaden */
  html.js .ill { opacity: 0; scale: .94; transition: opacity 1s cubic-bezier(.16,1,.3,1) var(--rd, 0ms), scale 1s cubic-bezier(.16,1,.3,1) var(--rd, 0ms); }
  html.js .ill.is-revealed { opacity: 1; scale: 1; }

  /* Hero-illustratie: losse vormen komen na elkaar, de stippen en het vinkje veren erin */
  .hero-ill .hi-float, .hero-ill .hi-pop, .hero-ill .hi-fade { transform-box: fill-box; transform-origin: center; }
  html.js .hero-ill .hi-float { opacity: 0; translate: 0 14px; }
  html.js .hero-ill .hi-pop { opacity: 0; scale: .3; }
  html.js .hero-ill .hi-fade { opacity: 0; }
  .ill.is-revealed .hero-ill .hi-float { animation: hi-float .9s cubic-bezier(.16,1,.3,1) var(--fd, 0s) both; }
  .ill.is-revealed .hero-ill .hi-pop { animation: hi-pop .6s cubic-bezier(.34,1.56,.64,1) var(--fd, 0s) both; }
  .ill.is-revealed .hero-ill .hi-fade { animation: hi-fade .8s ease-out 1.1s both; }
  @keyframes hi-float { to { opacity: 1; translate: 0 0; } }
  @keyframes hi-pop { to { opacity: 1; scale: 1; } }
  @keyframes hi-fade { to { opacity: 1; } }

  /* Driehoekjes: schuiven één keer naar beneden en veren terug (zoals op de homepage) */
  .tri path { transform-box: fill-box; }
  .tri.is-revealed path { animation: arrow-nudge 1.1s cubic-bezier(.37,0,.63,1) both; }
  .tri.is-revealed path + path { animation-delay: .14s; }

  /* Gele cirkels tekenen zichzelf in, nadat de zin er staat */
  html.js .qk path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .is-revealed .qk path { animation: qk-draw .9s cubic-bezier(.65,0,.35,1) .6s both; }
  .is-revealed .qk:nth-of-type(2) path { animation-delay: 1.3s; }
  @keyframes qk-draw { to { stroke-dashoffset: 0; } }

  /* Vijf stappen: nummers veren op, lijnen groeien, kaarten komen omhoog */
  .steps > li:nth-child(1) { --n: 0; } .steps > li:nth-child(2) { --n: 1; } .steps > li:nth-child(3) { --n: 2; } .steps > li:nth-child(4) { --n: 3; } .steps > li:nth-child(5) { --n: 4; }
  html.js .steps > li > div > span:first-child { opacity: 0; scale: .4; }
  html.js .steps > li > div > span + span { opacity: 0; scale: 0 1; transform-origin: left center; }
  html.js .steps .stepcard { opacity: 0; translate: 0 20px; }
  html.js .steps-loop { opacity: 0; }
  .steps.is-revealed > li > div > span:first-child { animation: hi-pop .6s cubic-bezier(.34,1.56,.64,1) calc(var(--n) * 150ms) both; }
  .steps.is-revealed > li > div > span + span { animation: step-line .5s cubic-bezier(.16,1,.3,1) calc(var(--n) * 150ms + 200ms) both; }
  html.js .steps.is-revealed .stepcard { opacity: 1; translate: none; transition: opacity .8s cubic-bezier(.16,1,.3,1) calc(var(--n) * 120ms + 350ms), translate .8s cubic-bezier(.16,1,.3,1) calc(var(--n) * 120ms + 350ms), transform .25s cubic-bezier(.16,1,.3,1); }
  .steps.is-revealed .steps-loop { animation: hi-fade .3s ease-out 1.1s both; }
  html.js .steps-loop__arc { clip-path: inset(0 0 0 100%); }
  .steps.is-revealed .steps-loop__arc { animation: loop-draw .9s cubic-bezier(.65,0,.35,1) 1.15s both; }
  @keyframes loop-draw { to { clip-path: inset(0 0 0 0); } }
  html.js .steps-loop__head { opacity: 0; }
  .steps.is-revealed .steps-loop__head { animation: hi-fade .3s ease-out 1.95s both; }
  @keyframes step-line { to { opacity: 1; scale: 1 1; } }

  /* Stippellijnen bij De scan "stromen" naar de resultaatkaart */
  html.js .flow-wrap svg { clip-path: inset(0 0 100% 0); transition: clip-path .9s cubic-bezier(.65,0,.35,1) .2s; }
  html.js .flow-wrap.is-revealed svg { clip-path: inset(0 0 0 0); }
  .scan-result { --rd: 600ms; }
}
@media print { html.js [data-rv], html.js .hero-ill *, html.js .steps * , html.js .qk path { opacity: 1 !important; translate: none !important; scale: none !important; clip-path: none !important; stroke-dashoffset: 0 !important; } }

.stepdialog { width: min(100% - 32px, 760px); max-height: calc(100dvh - 48px); margin: 24px auto; padding: 0; overflow: hidden; border: 0; border-radius: 8px; background: #ffffff; color: #232323; font-family: Poppins, sans-serif; letter-spacing: normal; }
/* --- Pop-up als presentatie: tabs bovenaan, dia's die zacht doorschuiven, pijlen onderaan --- */
.stepdialog { width: min(100% - 32px, 880px); }
.slidenav { position: relative; display: flex; gap: 4px; margin: 28px 0 0; padding-bottom: 2px; border-bottom: 2px solid #e3f0ff; }
.slidenav [role="tab"] { position: relative; margin: 0; padding: 10px 14px 12px; border: 0; background: none; font-family: Poppins, sans-serif; font-size: 16px; font-weight: 600; line-height: 1.2; color: #0d0064; opacity: .55; cursor: pointer; border-radius: 8px 8px 0 0; transition: opacity .3s ease, color .3s ease; }
.slidenav [role="tab"]:hover, .slidenav [role="tab"]:focus-visible { opacity: 1; }
.slidenav [role="tab"][aria-selected="true"] { opacity: 1; color: #0049dc; }
.slidenav [role="tab"]:focus-visible { outline: 3px solid #0049dc; outline-offset: -3px; }
.slidenav__bar { position: absolute; left: 0; bottom: -2px; height: 4px; width: 0; border-radius: 4px; background: #ffc518; transition: transform .45s cubic-bezier(.16,1,.3,1), width .45s cubic-bezier(.16,1,.3,1); }
.stepdialog__inner { display: flex; flex-direction: column; overflow: hidden; }
.stepdialog__inner > * { flex: none; }
.slides-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; margin: 28px -8px 0; padding: 2px 8px 8px; }
.slides { position: relative; min-height: 200px; }
.slide { min-width: 0; }
.slide[hidden] { display: none; }
.slide.is-leaving { position: absolute; left: 0; right: 0; top: 0; pointer-events: none; }
.slide__label { display: inline-block; margin: 0 0 16px; padding: 4px 12px; border-radius: 48px; background: #ffc518; color: #232323; font-size: 16px; font-weight: 600; line-height: 1.4; }
.slidefoot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 32px; padding-top: 24px; border-top: 2px solid #e3f0ff; }
.slidecount { font-size: 15px; font-weight: 600; color: #0d0064; opacity: .7; font-variant-numeric: tabular-nums; }
.slidebtn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; min-width: 48px; padding: 0 16px; border: 0; border-radius: 14.08px; background: #0049dc; color: #ffffff; font-family: Poppins, sans-serif; font-size: 16px; font-weight: 600; line-height: 1; box-shadow: 3.52px -3.52px 0 0 #232323; cursor: pointer; transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s cubic-bezier(.16,1,.3,1), opacity .25s ease; }
.slidebtn:hover, .slidebtn:focus-visible { transform: translate(-2px, 2px); box-shadow: 5.5px -5.5px 0 0 #232323; }
.slidebtn:active { transform: translate(1px, -1px); box-shadow: 2px -2px 0 0 #232323; }
.slidebtn:focus-visible { outline: 3px solid #0d0064; outline-offset: 3px; }
.slidebtn--prev { background: #ffffff; color: #0049dc; box-shadow: inset 0 0 0 3px #0049dc; }
.slidebtn--prev:hover, .slidebtn--prev:focus-visible { transform: none; box-shadow: inset 0 0 0 3px #0049dc; background: #e3f0ff; }
.slidebtn--prev[disabled] { opacity: .35; cursor: default; background: #ffffff; }
.slidebtn[hidden] { display: none; }
.slidebtn--done { padding: 0 22px; }
@media (prefers-reduced-motion: no-preference) {
  .slides { transition: height .42s cubic-bezier(.16,1,.3,1); }
  .slide { transition: opacity .42s cubic-bezier(.16,1,.3,1), translate .42s cubic-bezier(.16,1,.3,1); }
  .slide.is-leaving { opacity: 0; translate: calc(var(--dir, 1) * -32px) 0; }
  .slide.is-entering { opacity: 0; translate: calc(var(--dir, 1) * 32px) 0; transition: none; }
  .slide.is-active { opacity: 1; translate: 0 0; }
}
@media (max-width: 600px) {
  .slidenav { gap: 0; margin-top: 20px; overflow-x: auto; scrollbar-width: none; }
  .slidenav [role="tab"] { padding: 10px 10px 12px; font-size: 14px; white-space: nowrap; }
  .slides { margin-top: 22px; }
  .slidefoot { margin-top: 24px; padding-top: 18px; }
  .slidebtn--done { font-size: 15px; padding: 0 14px; }
}
.stepdialog::backdrop { background: rgba(13, 0, 100, 0.55); }
.stepdialog__inner { position: relative; max-height: calc(100dvh - 48px); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding: clamp(28px, 4vw, 48px); }
.stepdialog h3, .stepdialog h4, .stepdialog p, .stepdialog ul { letter-spacing: normal; }
@media (prefers-reduced-motion: no-preference) {
  .stepdialog[open] { animation: dialog-in 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes dialog-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
}
</style>

<script>
  const steps = document.querySelector<HTMLElement>('[data-steps]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  if (steps) {
    const update = () => {
      const max = steps.scrollWidth - steps.clientWidth;
      const step = max > 0 ? Math.round((steps.scrollLeft / max) * 4) : 0;
      steps.classList.toggle('is-end', max > 0 && steps.scrollLeft > max - 8);
      steps.classList.toggle('is-mid', steps.scrollLeft >= 8 && steps.scrollLeft <= max - 8);
      dots.forEach((d, i) => {
        d.style.width = i === step ? '28px' : '8px';
        d.style.background = i === step ? '#0049dc' : '#c7ddff';
      });
    };
    steps.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Alles komt zacht in beeld zodra je erbij scrolt (zelfde ritme als de homepage).
  const rvTargets = [...document.querySelectorAll<HTMLElement>('[data-rv]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    rvTargets.forEach((el) => el.classList.add('is-revealed'));
  } else {
    const io = new IntersectionObserver((entries) => {
      let i = 0;
      entries.filter((e) => e.isIntersecting).forEach((e) => {
        const el = e.target as HTMLElement;
        if (!el.style.getPropertyValue('--rd')) el.style.setProperty('--rd', `${Math.min(i++, 4) * 80}ms`);
        el.classList.add('is-revealed');
        io.unobserve(el);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
    rvTargets.forEach((el) => io.observe(el));
  }

  // Presentatie in de pop-up: tabs, pijlen, toetsen en swipen.
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const decks = new Map<HTMLDialogElement, { go: (i: number, focusTab?: boolean) => void; cur: () => number; total: number }>();
  document.querySelectorAll<HTMLDialogElement>('.stepdialog').forEach((dialog) => {
    const tabs = [...dialog.querySelectorAll<HTMLButtonElement>('[data-slide-tab]')];
    const slides = [...dialog.querySelectorAll<HTMLElement>('.slide')];
    const bar = dialog.querySelector<HTMLElement>('.slidenav__bar');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-slide-next]');
    const done = dialog.querySelector<HTMLButtonElement>('[data-step-next]');
    const count = dialog.querySelector<HTMLElement>('[data-slide-current]');
    const track = dialog.querySelector<HTMLElement>('[data-slides-track]');
    const scroller = dialog.querySelector<HTMLElement>('.slides-scroll');
    const total = slides.length;
    let cur = 0, settle = 0;
    const placeBar = () => {
      const t = tabs[cur]; if (!bar || !t) return;
      bar.style.width = `${t.offsetWidth}px`;
      bar.style.transform = `translateX(${t.offsetLeft}px)`;
    };
    const go = (i: number, focusTab = false) => {
      i = Math.max(0, Math.min(total - 1, i));
      const dir = i > cur ? 1 : -1;
      const from = slides[cur], to = slides[i];
      if (i !== cur) {
        dialog.style.setProperty('--dir', String(dir));
        from.classList.remove('is-active');
        if (prefersReduce || !track) {
          from.hidden = true;
          to.hidden = false;
        } else {
          // Hoogte van de oude naar de nieuwe dia laten glijden; de oude schuift uit, de nieuwe in.
          const h0 = track.offsetHeight;
          track.style.height = `${h0}px`;
          from.classList.add('is-leaving');
          to.hidden = false;
          to.classList.add('is-entering');
          const h1 = to.offsetHeight;
          void track.offsetWidth;
          track.style.height = `${h1}px`;
          to.classList.remove('is-entering');
          window.clearTimeout(settle);
          settle = window.setTimeout(() => {
            from.hidden = true; from.classList.remove('is-leaving');
            slides.forEach((sl) => { if (sl !== slides[cur]) { sl.hidden = true; sl.classList.remove('is-leaving'); } });
            track.style.height = '';
          }, 460);
        }
        to.classList.add('is-active');
        cur = i;
        scroller?.scrollTo({ top: 0, behavior: prefersReduce ? 'auto' : 'smooth' });
      }
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === cur)); t.tabIndex = k === cur ? 0 : -1; });
      if (focusTab) tabs[cur]?.focus();
      if (prev) prev.disabled = cur === 0;
      const last = cur === total - 1;
      const hadFocus = document.activeElement;
      if (next) next.hidden = last;
      if (done) done.hidden = !last;
      // Verdwijnt de knop die focus had, dan gaat de focus naar zijn vervanger (anders raak je 'm kwijt).
      if (hadFocus === next && last) done?.focus();
      else if (hadFocus === done && !last) next?.focus();
      else if (hadFocus === prev && cur === 0) next?.focus();
      if (count) count.textContent = String(cur + 1);
      placeBar();
    };
    tabs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    prev?.addEventListener('click', () => go(cur - 1));
    next?.addEventListener('click', () => go(cur + 1));
    done?.addEventListener('click', () => {
      const n = Number(done.dataset.stepNext);
      dialog.close();
      if (n) document.querySelector<HTMLButtonElement>(`[data-step-open="${n}"]`)?.click();
    });
    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1, document.activeElement?.hasAttribute('data-slide-tab')); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1, document.activeElement?.hasAttribute('data-slide-tab')); }
      if (e.key === 'Home') { e.preventDefault(); go(0); }
      if (e.key === 'End') { e.preventDefault(); go(total - 1); }
    });
    // Swipen op touch
    let sx = 0, sy = 0, swiping = false;
    dialog.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; sx = e.clientX; sy = e.clientY; swiping = true; });
    dialog.addEventListener('pointerup', (e) => {
      if (!swiping) return; swiping = false;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) go(cur + (dx < 0 ? 1 : -1));
    });
    dialog.addEventListener('pointercancel', () => { swiping = false; });
    decks.set(dialog, { go, cur: () => cur, total });
    window.addEventListener('resize', () => { if (dialog.open) placeBar(); });
    go(0);
  });

  // Lus 4↔5: elke keer dat de stappen in beeld komen, loopt er één gele stip langs de lus (2,4 s).
  const loop = document.querySelector<HTMLElement>('.steps-loop');
  const motion = loop?.querySelector<SVGAnimateMotionElement>('[data-flow-motion]');
  const fade = loop?.querySelector<SVGAnimateElement>('[data-flow-fade]');
  if (loop && motion && fade && !reduce && 'IntersectionObserver' in window && getComputedStyle(loop).display !== 'none') {
    const setPath = () => {
      const w = loop.offsetWidth, h = loop.offsetHeight, o = 8, r = 28.5, i = 1.5;
      motion.setAttribute('path', `M${w - i + o} ${h + o} L${w - i + o} ${r + o} A${r} ${r} 0 0 0 ${w - i - r + o} ${i + o} L${i + r + o} ${i + o} A${r} ${r} 0 0 0 ${i + o} ${r + o} L${i + o} ${h + o - 2}`);
    };
    setPath();
    window.addEventListener('resize', setPath);
    let first = true;
    const play = () => { setPath(); (motion as any).beginElement(); (fade as any).beginElement(); };
    const lio = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      window.setTimeout(play, first ? 2300 : 300);
      first = false;
    }), { threshold: 0.6 });
    lio.observe(loop);
  }

  // Pop-ups per stap: native <dialog> (focus blijft erin, Escape sluit, klik buiten sluit).
  // De pagina erachter wordt vastgezet (ook op iOS), zodat je in de pop-up scrolt.
  let lockedY = 0;
  const touchLock = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  document.querySelectorAll<HTMLButtonElement>('[data-step-open]').forEach((btn) => {
    const dialog = document.querySelector<HTMLDialogElement>(`#step-${btn.dataset.stepOpen}`);
    if (!dialog) return;
    btn.addEventListener('click', () => {
      lockedY = window.scrollY;
      window.dispatchEvent(new Event('lenis:stop'));
      dialog.showModal();
      const deck = decks.get(dialog);
      if (deck) { deck.go(0); requestAnimationFrame(() => deck.go(0)); }
      document.documentElement.style.overflow = 'hidden';
      // Op touch-apparaten (iOS) helpt overflow:hidden niet; daar zetten we de pagina letterlijk vast.
      if (touchLock) Object.assign(document.body.style, { position: 'fixed', top: `-${lockedY}px`, left: '0', right: '0', width: '100%', overflow: 'hidden' });
    });
    dialog.querySelector('[data-step-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { window.dispatchEvent(new Event('lenis:start')); document.documentElement.style.overflow = ''; if (touchLock) { Object.assign(document.body.style, { position: '', top: '', left: '', right: '', width: '', overflow: '' }); window.scrollTo(0, lockedY); } btn.focus(); });
  });
</script>
