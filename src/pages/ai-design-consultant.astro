.flowline{fill:none;stroke:#0049dc;stroke-width:3;stroke-linecap:round;stroke-dasharray:3 11;animation:flowdown 1.4s linear infinite}@keyframes flowdown{to{stroke-dashoffset:-28}}
@media (max-width:860px){.flow-wrap{display:none}.scan-result{margin-top:40px !important;padding:36px 24px 32px !important}}
@media (prefers-reduced-motion:reduce){.flowline{animation:none}}
.steplink { display: inline-flex; align-items: center; gap: 8px; margin: 0 2px; padding: 4px 10px 4px 5px; border: 0; border-radius: 48px; background: #e3f0ff; color: #0d0064; font-family: Poppins, sans-serif; font-size: 17px; font-weight: 600; line-height: 1.3; vertical-align: middle; position: relative; top: -1px; cursor: pointer; white-space: nowrap; transition: background .25s ease, color .25s ease; }
.steplink__num { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; font-size: 13px; font-weight: 600; line-height: 1; transition: background .25s ease, color .25s ease, box-shadow .25s ease; }
.steplink__num--y { background: #ffc518; color: #232323; }
.steplink__num--b { background: #ffffff; color: #0049dc; box-shadow: inset 0 0 0 2px #0049dc; }
.steplink__plus { width: 14px; height: 14px; color: #0049dc; transition: transform .35s cubic-bezier(.16,1,.3,1), color .25s ease; }
.steplink:hover, .steplink:focus-visible { background: #0049dc; color: #ffffff; }
.steplink:hover .steplink__plus, .steplink:focus-visible .steplink__plus { color: #ffffff; transform: rotate(90deg); }
.steplink:hover .steplink__num--b, .steplink:focus-visible .steplink__num--b { box-shadow: inset 0 0 0 2px #ffffff; }
.steplink:focus-visible { outline: 3px solid #0d0064; outline-offset: 2px; }
.steplink--lg { padding: 8px 16px 8px 8px; gap: 10px; font-size: 16px; top: 0; }
.steplink--lg .steplink__num { width: 28px; height: 28px; font-size: 14px; }
#scan .scan-result li { line-height: 1.7; }
.stepcard__plus { position: absolute; right: 16px; bottom: 16px; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #e3f0ff; color: #0049dc; transition: background .25s ease, color .25s ease, transform .35s cubic-bezier(.16,1,.3,1); }
