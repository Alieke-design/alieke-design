---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Pagina niet gevonden - Alieke.design" noindex>
  <section class="text-image" id="hi">
    <div class="text-image__inner">
      <div class="text-image__text">
        <p class="label background--dyellow font-semibold">404</p>
        <h1 class="large-heading color--ddarkblue">Deze pagina bestaat niet (meer)</h1>
        <div class="default-body p"><p>Misschien is hij verhuisd. Op de homepage vind je mijn werk, skills en contactgegevens.</p></div>
        <a class="button" href="/">
          <span class="button__text">Naar de homepage</span>
          <span class="button__icon is-arrow-right"><Icon name="arrow-right" /></span>
        </a>
      </div>
    </div>
  </section>
</Base>
