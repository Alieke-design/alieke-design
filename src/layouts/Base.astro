---
import '../styles/theme.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

interface Props { title?: string; description?: string; ogImage?: string; ogImageAlt?: string; noindex?: boolean; nav?: { href: string; label: string }[]; menuNote?: string }
const { title = site.title, description = site.description, ogImage = '/og-home.png', ogImageAlt = 'Alieke Zelhorst, freelance UX/UI designer: Ik maak complexe apps en tools intuïtief en toegankelijk.', noindex = false, nav, menuNote } = Astro.props;
const ogImageUrl = new URL(ogImage, 'https://alieke.design').href;
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, inLanguage: 'nl-NL', isPartOf: { '@id': `${site.url}/#website` } },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.title, inLanguage: 'nl-NL' },
    { '@type': 'Person', name: 'Alieke Zelhorst', jobTitle: 'Freelance UX/UI designer en WCAG specialist', url: `${site.url}/`, email: site.email, sameAs: [site.linkedin], address: { '@type': 'PostalAddress', streetAddress: 'Hooghiemstraplein 67', addressLocality: 'Utrecht', addressCountry: 'NL' } },
  ],
};
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/a6824ee4d498fe7367c7.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/64aed377be36e822042b.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="color--dark">
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header items={nav} menuNote={menuNote} />
    <div class="smooth-scroll">
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
