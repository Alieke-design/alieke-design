---
// Raster van gele stippen (4 x 3). Elke stip zit in een eigen <g>, zodat het
// binnenkomen (op de g) en het uitwijken voor de muis (op de circle) niet botsen.
const xs = [6.6, 46.2, 85.8, 125.4];
const ys = [6.6, 46.2, 85.8];
---
<svg fill="none" viewBox="0 0 132 93" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" data-dots>
  {ys.map((cy, row) => xs.map((cx, col) => (
    <g class="dot" style={`--d:${row + col}`}><circle cx={cx} cy={cy} r="6.6" fill="#FFC518" /></g>
  )))}
</svg>
