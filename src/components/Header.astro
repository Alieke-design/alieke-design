---
import { site } from '../config';

interface Props { items?: { href: string; label: string }[]; menuNote?: string }
const defaultItems = [
  { href: '#hi', label: 'Hi 👋' },
  { href: '#werk', label: 'Werk' },
  { href: '#skills', label: 'Skills' },
  { href: '#aanbevelingen', label: 'Aanbevelingen' },
  { href: '#over-mij', label: 'Over mij' },
  { href: '#contact', label: 'Contact' },
];
const { items = defaultItems, menuNote = 'Ik reageer binnen een werkdag.' } = Astro.props;

const copyIcon =
  'M384 336H192c-8.8 0-16-7.2-16-16V64c0-8.8 7.2-16 16-16h140.1L400 115.9V320c0 8.8-7.2 16-16 16zM192 384h192c35.3 0 64-28.7 64-64V115.9c0-12.7-5.1-24.9-14.1-33.9L366.1 14.1c-9-9-21.2-14.1-33.9-14.1H192c-35.3 0-64 28.7-64 64v256c0 35.3 28.7 64 64 64zM64 128c-35.3 0-64 28.7-64 64v256c0 35.3 28.7 64 64 64h192c35.3 0 64-28.7 64-64v-32h-48v32c0 8.8-7.2 16-16 16H64c-8.8 0-16-7.2-16-16V192c0-8.8 7.2-16 16-16h32v-48H64z';
---
<header class="header color--ddarkblue">
  <div class="header__inner">
    <nav aria-label="Hoofdmenu" class="header__nav nav--top">
      <a class="header__logo" href="/">
        <img alt="Alieke.design, naar de homepage" src="/img/logos/alieke-logo.svg" width="165" height="26" />
      </a>
      <ul class="header__list default-body">
        {items.map((item) => (
          <li class="header__item">
            <div class="header__text-container">
              <a class="header__link" href={item.href}>
                <span class="header__text">{item.label}</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        Menu
      </button>
    </nav>
  </div>
</header>

<dialog class="mobile-menu" id="mobile-menu" aria-label="Menu">
  <div class="mobile-menu__bar">
    <a class="header__logo" href="/">
      <img alt="Alieke.design, naar de homepage" src="/img/logos/alieke-logo.svg" width="165" height="26" />
    </a>
    <button class="menu-toggle" type="button" data-menu-close autofocus>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      Sluiten
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Hoofdmenu">
    <ul>
      {items.map((item) => (
        <li><a href={item.href} data-section={item.href.slice(1)}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="mobile-menu__contact">
    <p>{menuNote}</p>
    <button class="button tip contact-copy" type="button" data-copy={site.email} aria-label={`${site.email} kopiëren`}>
      <span class="button__icon contact-copy__icon">
        <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d={copyIcon} /></svg>
      </span>
      <span class="button__text">{site.email}</span>
      <span class="tip__bubble" aria-hidden="true" data-copy-label>Kopiëren</span>
    </button>
    <span class="visually-hidden" aria-live="polite" data-copy-status></span>
  </div>
  <svg class="mobile-menu__dots" viewBox="0 0 132 93" aria-hidden="true"><g fill="#FFC518"><circle cx="6.6" cy="6.6" r="6.6" /><circle cx="46.2" cy="6.6" r="6.6" /><circle cx="85.8" cy="6.6" r="6.6" /><circle cx="125.4" cy="6.6" r="6.6" /><circle cx="6.6" cy="46.2" r="6.6" /><circle cx="46.2" cy="46.2" r="6.6" /><circle cx="85.8" cy="46.2" r="6.6" /><circle cx="125.4" cy="46.2" r="6.6" /><circle cx="6.6" cy="85.8" r="6.6" /><circle cx="46.2" cy="85.8" r="6.6" /><circle cx="85.8" cy="85.8" r="6.6" /><circle cx="125.4" cy="85.8" r="6.6" /></g></svg>
</dialog>
