---
// Eigen cookiemelding (geen widget). Wordt alleen getoond als er een
// Google Analytics-ID in src/config.ts staat. Analytics laadt pas na "Akkoord".
import { site } from '../config';
const gaId = site.googleAnalyticsId;
---
{gaId && (
  <div class="cookie-banner" role="region" aria-label="Cookiemelding" data-ga-id={gaId} hidden>
    <div class="cookie-banner__inner">
      <p class="cookie-banner__text default-body">
        Mag ik anonieme statistieken bijhouden met Google Analytics? Dan zie ik hoe de site gebruikt wordt. Zonder toestemming plaats ik geen cookies.
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="button" data-consent="granted">Akkoord</button>
        <button type="button" class="cookie-banner__decline" data-consent="denied">Liever niet</button>
      </div>
    </div>
  </div>
)}
