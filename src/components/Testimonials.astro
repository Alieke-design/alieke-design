---
import { Image } from 'astro:assets';
import { aanbevelingen, recommendationsUrl } from '../data/aanbevelingen';
---
<section class="widget-block background--dlightblue" data-scroll-var data-start="top bottom" id="aanbevelingen">
  <div class="widget-block__inner">
    <p class="label background--dblue font-semibold">Aanbevelingen</p>
    <h2 class="large-heading color--ddarkblue">Opdrachtgevers</h2>
    <p class="text-image__subtitle xsmall-heading font-regular color--dblue">Over mij</p>
    <ul class="reviews" role="list" aria-label="Aanbevelingen van opdrachtgevers" tabindex="0">
      {aanbevelingen.map((review, i) => {
        const href = review.linkedin || recommendationsUrl;
        return (
          <li class="review" lang={review.lang}>
            <div class="review__author">
              <a class="review__avatar tip" href={href} target="_blank" rel="noopener" aria-label={`${review.name} op LinkedIn (opent in nieuw venster)`}>
                <Image src={review.photo} alt="" width={40} height={40} densities={[1, 2]} class="review__photo" loading="lazy" />
                <span class="review__source" aria-hidden="true">
                  <svg viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill="#fff" stroke="#fff" stroke-linejoin="round" stroke-width="2" d="M4 1.5a3 3 0 0 0-3 3v16a3 3 0 0 0 3 3h16a3 3 0 0 0 3-3v-16a3 3 0 0 0-3-3H4Z"/><path fill="#0A66C2" d="M2 4.5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-16Z"/><path fill="#fff" d="M19.155 19.644h-2.963v-4.641c0-1.107-.02-2.532-1.542-2.532-1.543 0-1.78 1.207-1.78 2.45v4.723H9.907V10.1h2.845v1.305h.04a3.125 3.125 0 0 1 2.806-1.542c3.004 0 3.559 1.976 3.559 4.547l-.002 5.235ZM6.563 8.794a1.728 1.728 0 0 1-1.72-1.718c0-.943.777-1.72 1.72-1.72a1.73 1.73 0 0 1 1.72 1.72c0 .943-.776 1.718-1.72 1.718Zm1.482 10.85H5.078V10.1h2.967v9.545Z"/></svg>
                </span>
                <span class="tip__bubble" aria-hidden="true" lang="nl">Geplaatst op LinkedIn</span>
              </a>
              <div class="review__info">
                <p class="review__name">
                  <a href={href} target="_blank" rel="noopener">{review.name}<span class="visually-hidden" lang="nl"> (opent in nieuw venster)</span></a>
                  <span class="review__verified tip" role="img" aria-label="Geverifieerd" lang="nl">
                    <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#197BFF" d="M6.757.236a.35.35 0 0 1 .486 0l1.106 1.07a.35.35 0 0 0 .329.089l1.493-.375a.35.35 0 0 1 .422.244l.422 1.48a.35.35 0 0 0 .24.24l1.481.423a.35.35 0 0 1 .244.422l-.375 1.493a.35.35 0 0 0 .088.329l1.071 1.106a.35.35 0 0 1 0 .486l-1.07 1.106a.35.35 0 0 0-.089.329l.375 1.493a.35.35 0 0 1-.244.422l-1.48.422a.35.35 0 0 0-.24.24l-.423 1.481a.35.35 0 0 1-.422.244l-1.493-.375a.35.35 0 0 0-.329.088l-1.106 1.071a.35.35 0 0 1-.486 0l-1.106-1.07a.35.35 0 0 0-.329-.089l-1.493.375a.35.35 0 0 1-.422-.244l-.422-1.48a.35.35 0 0 0-.24-.24l-1.481-.423a.35.35 0 0 1-.244-.422l.375-1.493a.35.35 0 0 0-.088-.329L.236 7.243a.35.35 0 0 1 0-.486l1.07-1.106a.35.35 0 0 0 .089-.329L1.02 3.829a.35.35 0 0 1 .244-.422l1.48-.422a.35.35 0 0 0 .24-.24l.423-1.481a.35.35 0 0 1 .422-.244l1.493.375a.35.35 0 0 0 .329-.088L6.757.236Z"/><path fill="#fff" fill-rule="evenodd" clip-rule="evenodd" d="M9.065 4.85a.644.644 0 0 1 .899 0 .615.615 0 0 1 .053.823l-.053.059L6.48 9.15a.645.645 0 0 1-.84.052l-.06-.052-1.66-1.527a.616.616 0 0 1 0-.882.645.645 0 0 1 .84-.052l.06.052 1.21 1.086 3.034-2.978Z"/></svg>
                    <span class="tip__bubble" aria-hidden="true">Geverifieerd</span>
                  </span>
                </p>
                <p class="review__role">{review.role}</p>
              </div>
            </div>
            <p class="review__badge" lang="nl">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" d="M5 21a3 3 0 0 1-2.995-2.824L2 18v-6a3 3 0 0 1 2.824-2.995L5 9h2.224l4.458-8H12.8a4 4 0 0 1 4 4l-.001 3h2.64l.177.006.112.008.204.027c1.553.259 2.638 1.672 2.49 3.268l-.024.184-1.333 7c-.227 1.36-1.35 2.387-2.758 2.5l-.201.007H5Zm7.915-17.996L8.8 10.235V19h9.266l.121-.003a1 1 0 0 0 .905-.833l1.328-6.963.015-.112c.048-.518-.314-.99-.79-1.07l-.123-.016a1 1 0 0 0-.083-.003H14.8V5a2 2 0 0 0-2-2l.115.004Z"/></svg>
              Aanbevolen
            </p>
            <div class="review__text" id={`review-${i}`}>
              {review.text.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
            </div>
            <button class="review__toggle" type="button" aria-expanded="false" aria-controls={`review-${i}`} hidden>
              <span class="review__toggle-more" lang="nl">Lees meer</span>
              <span class="review__toggle-less" lang="nl">Minder tonen</span>
            </button>
          </li>
        );
      })}
    </ul>
  </div>
</section>
