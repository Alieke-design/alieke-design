---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Quote from './Quote.astro';
import portrait from '../assets/img/Alieke-Zelhorst-freelance-UX-UI-designer.png';
---
<section class="text-image" data-scroll-var data-start="top top" id="hi">
  <div class="text-image__inner">
    <div class="text-image__text">
      <p class="label background--dblue font-semibold">Hi! 👋</p>
      <h1 class="large-heading color--ddarkblue">Freelance UX/UI designer</h1>
      <p class="text-image__subtitle xsmall-heading font-regular color--dblue">Alieke Zelhorst</p>
      <Quote text="Ik maak complexe apps en tools *intuïtief* en *toegankelijk*." />
      <div class="default-body p">
        <ul>
          <li><span>Senior UX/UI designer met 15 jaar ervaring</span></li>
          <li><span>Gediplomeerd WCAG specialist</span></li>
          <li><span>Bedreven in het verbeteren van AI producten</span></li>
        </ul>
      </div>
      <a class="button button--anchor" href="#werk">
        <span class="button__text">Bekijk werk</span>
        <span class="button__icon is-arrow-down"><Icon name="arrow-down" /></span>
      </a>
    </div>
    <div class="text-image__media" style="--ratio: 514/408">
      <svg class="clippie" style="--ratio: 408/514" viewBox="0 0 408 514" aria-hidden="true">
        <clipPath clipPathUnits="objectBoundingBox" id="image-shape">
          <path d="M0,0 L408,0 L408,310 C408,422.666089 316.666089,514 204,514 C91.333911,514 0,422.666089 0,310 L0,0 Z" fill="#000000"></path>
        </clipPath>
      </svg>
      <Image
        src={portrait}
        alt="Foto van Alieke Zelhorst, freelance UX/UI designer uit Utrecht"
        widths={[400, 600, 800]}
        sizes="(max-width: 750px) 80vw, 336px"
        loading="eager"
        fetchpriority="high"
        style="--ratio:1"
      />
    </div>
  </div>
</section>
