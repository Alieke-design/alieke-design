---
import { site } from '../config';
const dots: [number, number][] = [];
for (let x = 4; x <= 204; x += 40) for (let y = 4; y <= 204; y += 40) dots.push([x, y]);
---
<section class="form is-footer-layout background--dlightblue" id="contact">
  <div class="form__inner">
    <div class="form__svg" data-scroll-offset-y="top bottom" data-scroll-translate data-target="parent" data-translate-y="2" aria-hidden="true">
      <svg viewBox="0 0 208 208" xmlns="http://www.w3.org/2000/svg">
        <g fill="#FFC518">{dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="4" />)}</g>
      </svg>
    </div>
    <div class="form__text">
      <p class="label background--dyellow font-semibold">Contact</p>
      <h2 class="large-heading color--dblue">Vertel..</h2>
      <div class="default-body p">
        <p>Ik ben benieuwd wie jij bent en wat ik voor je kan betekenen. Ik reageer binnen een werkdag.</p>
      </div>
      <button class="button tip contact-copy" type="button" data-copy={site.email} aria-label={`${site.email} kopiëren`}>
        <span class="button__text">{site.email}</span>
        <span class="button__icon">
          <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M384 336H192c-8.8 0-16-7.2-16-16V64c0-8.8 7.2-16 16-16h140.1L400 115.9V320c0 8.8-7.2 16-16 16zM192 384h192c35.3 0 64-28.7 64-64V115.9c0-12.7-5.1-24.9-14.1-33.9L366.1 14.1c-9-9-21.2-14.1-33.9-14.1H192c-35.3 0-64 28.7-64 64v256c0 35.3 28.7 64 64 64zM64 128c-35.3 0-64 28.7-64 64v256c0 35.3 28.7 64 64 64h192c35.3 0 64-28.7 64-64v-32h-48v32c0 8.8-7.2 16-16 16H64c-8.8 0-16-7.2-16-16V192c0-8.8 7.2-16 16-16h32v-48H64z"/></svg>
        </span>
        <span class="tip__bubble" aria-hidden="true" data-copy-label>Kopiëren</span>
      </button>
      <span class="visually-hidden" aria-live="polite" data-copy-status></span>
      <div class="contact-spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>
